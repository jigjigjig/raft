# Runtime mode: mock keeps the full product testable without external credentials.
RAFT_OTARI_MODE=mock
RAFT_DATABASE_PATH=/data/raft.db
RAFT_MODEL_ROLES_PATH=/app/model-roles.yaml
RAFT_WEB_DIST_PATH=/app/web/dist
RAFT_APP_URL=http://localhost:8010
RAFT_HOST_PORT=8010
RAFT_PUBLIC_APP_URL=
RAFT_PUBLIC_MCP_URL=
RAFT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAFT_EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# Otari has distinct generation and platform API origins.
OTARI_GENERATION_BASE_URL=https://api.otari.ai
OTARI_PLATFORM_BASE_URL=https://app.otari.ai
OTARI_GUARDRAIL_PROFILE=prompt-injection
# How many aspect evaluations run at once. The hosted gateway's authorization
# service fails under concurrency, and how much it tolerates changes by the
# hour: 12 in flight was clean early in the day and returned 12.5% success a
# few hours later. Measured per-call success over 40 calls at each level:
#   1 -> 100%,  2 -> 87.5%,  3 -> 82.5%,  4 -> 65%,  6 -> 24%,  12 -> 12.5%
# At 3, a row only fails after four consecutive 5xx (the retries in
# raft/analysis.py), so an 847-row run expects under one paused row.
RAFT_ASPECT_CONCURRENCY=3
OTARI_PLANNER_MCP_SERVER_ID=

# One workspace/API key per model role. Leave blank in mock mode.
OTARI_TRACE_LABELER_API_KEY=
OTARI_ASPECT_EVALUATOR_API_KEY=
OTARI_CLUSTER_NAMER_API_KEY=
OTARI_AUTOPSY_WRITER_API_KEY=
OTARI_SPAN_EXPLAINER_API_KEY=
OTARI_PLANNER_API_KEY=

# Stable Cloudflare Tunnel. Leave blank to run locally only.
CLOUDFLARE_TUNNEL_TOKEN=

# Alternative to Otari for live mode: any OpenAI-compatible Chat Completions
# endpoint. Otari-only request fields (guardrails, MCP server ids, server-side
# tools, the sandbox) are not sent in this mode, and Settings labels it.
RAFT_LLM_PROVIDER=otari
RAFT_LLM_BASE_URL=
RAFT_LLM_API_KEY=
RAFT_LLM_MODEL=
